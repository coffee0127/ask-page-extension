{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_ext_name__",
  "short_name": "__MSG_ext_short_name__",
  "version": "0.36.0",
  "description": "__MSG_ext_description__",  "permissions": [
    "storage",
    "activeTab",
    "userScripts"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "minimum_chrome_version": "135",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "lib/highlight.min.js",
        "lib/marked.min.js",
        "lib/purify.min.js",
        "lib/i18n.js",
        "content.js"
      ]
    }
  ],
  "commands": {
    "toggle-dialog": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "__MSG_cmd_toggle_dialog__"
    },
    "switch-provider": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "__MSG_cmd_switch_provider__"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "style.css",
        "icons/askpage-mark.png",
        "icons/icon16.png",
        "icons/icon32.png",
        "icons/icon48.png",
        "icons/icon128.png",
        "lib/marked.min.js",
        "lib/purify.min.js",
        "_locales/en/messages.json",
        "_locales/zh_TW/messages.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
